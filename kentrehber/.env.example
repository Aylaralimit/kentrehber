# Local host processes. Generate random local secrets with: pnpm env:init
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://kentrehber:CHANGE_ME@127.0.0.1:5432/kentrehber?schema=public&connection_limit=5&connect_timeout=3&pool_timeout=3
POSTGRES_USER=kentrehber
POSTGRES_DB=kentrehber
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=
HEALTH_TOKEN=
BETTER_AUTH_SECRET=
# Only enable behind the private Caddy proxy, which overwrites the client-IP header.
TRUST_PROXY=false
DEPLOY_VERTICAL=restoran
# Cloud media is explicitly disabled until all real credentials are supplied.
MEDIA_ENABLED=false
# Optional Cloudflare Images uploads through the admin panel (R2 is not required).
CF_IMAGES_UPLOAD_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_ACCOUNT_HASH=
# Full Compose stack uses HTTPS; Caddy issues a local certificate for localhost.
DOCKER_APP_URL=https://localhost
CADDY_ADDRESS=localhost
BIND_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
